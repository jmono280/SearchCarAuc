# ------------------------------------------------------------------
# Configuración general
# ------------------------------------------------------------------

# Timeout en segundos para las peticiones de scraping.
request_timeout=30

# true = usa Playwright directamente sin intentar httpx primero.
# Recomendado en servidores remotos donde httpx suele ser detectado.
FORCE_PLAYWRIGHT=true

# ------------------------------------------------------------------
# Proveedor: IAAI (implementado)
# ------------------------------------------------------------------

# URL completa de búsqueda.
IAAI_URL=https://www.iaai.com/Search

# Nombre identificador (aparece en cada vehículo como `fuente`).
IAAI_NAME=IAAI

# Credenciales de login.
IAAI_USERNAME=tu_usuario@ejemplo.com
IAAI_PASSWORD=tu_password

# ------------------------------------------------------------------
# Proveedor: Manheim (placeholder / pendiente de implementar)
# ------------------------------------------------------------------

MANHEIM_ENABLED=false
# MANHEIM_URL=https://www.manheim.com/members/inventory/search
# MANHEIM_NAME=Manheim
# MANHEIM_USERNAME=tu_usuario
# MANHEIM_PASSWORD=tu_password

# ------------------------------------------------------------------
# Proveedor: ACV Auctions (placeholder / pendiente de implementar)
# ------------------------------------------------------------------

ACV_ENABLED=false
# ACV_URL=https://www.acvauctions.com/search
# ACV_NAME=ACV
# ACV_USERNAME=tu_usuario
# ACV_PASSWORD=tu_password

# ------------------------------------------------------------------
# Proveedor: OpenLane (placeholder / pendiente de implementar)
# ------------------------------------------------------------------

OPENLANE_ENABLED=false
# OPENLANE_URL=https://www.openlane.com/search
# OPENLANE_NAME=OpenLane
# OPENLANE_USERNAME=tu_usuario
# OPENLANE_PASSWORD=tu_password

# ------------------------------------------------------------------
# Nombres antiguos (compatibilidad). Solo se usan si no hay IAAI_USERNAME / IAAI_PASSWORD.
# user_ai_ai=tu_usuario@ejemplo.com
# psw=tu_password
